<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MikAcademy" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/mik_bg</item>
        <item name="android:statusBarColor">@color/mik_bg</item>
        <item name="android:navigationBarColor">@color/mik_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <style name="Theme.MikAcademy.Splash" parent="Theme.MikAcademy">
        <item name="android:windowBackground">@drawable/splash_screen</item>
        <item name="android:statusBarColor">@color/mik_bg_dark</item>
        <item name="android:navigationBarColor">@color/mik_bg_dark</item>
    </style>

</resources>
