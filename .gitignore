# Секреты и ключи (никогда не коммитим)
*.jks
*.keystore
*.p12
*.p12.b64
android/keystore/*
# отладочный ключ — намеренно в репозитории: он ничего не защищает,
# но позволяет обновлять отладочные сборки поверх предыдущих
!android/keystore/mik-debug.p12
!android/keystore/mik-debug.properties
android/local.properties
.secrets/
.env
.env.*

# Промежуточные материалы (озвучка пересобирается из media/narration.json)
media/audio/
media/slides/

# media/voice/ — кэш накопленных клипов озвучки. Он намеренно НЕ внесён
# в игнорирование: окружение удаляет игнорируемые файлы между заходами,
# и кэш должен пережить очистку. В репозиторий он не попадает: коммитьте
# явными путями (git add -u), а не через git add -A.

# Node / сборка
node_modules/
.gradle/
build/
dist/
out/
.idea/
*.iml
.vscode/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# образцы озвучки для прослушивания (не публикуются)
media/samples/
